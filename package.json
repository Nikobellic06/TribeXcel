{
  "name": "tribexcel",
  "version": "2.0.0",
  "description": "Ministry of Tribal Affairs — AI-Enabled Scholarship & Fellowship Management Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/api-server",
    "packages/*"
  ],
  "scripts": {
    "dev:student": "npm --prefix apps/student-portal run dev",
    "dev:admin": "npm --prefix apps/admin-portal run dev",
    "dev:api": "npm --prefix services/api-server run dev",
    "build:student": "npm --prefix apps/student-portal run build",
    "build:admin": "npm --prefix apps/admin-portal run build",
    "build:all": "npm run build:student && npm run build:admin",
    "seed:admin": "node scripts/development/seedAdmin.js",
    "test:security": "node tests/security/securityAudit.js",
    "test:digilocker": "node services/api-server/scripts/testDigiLockerSandbox.js",
    "test:wallet": "node tests/digilocker/walletE2ETest.js",
    "test:e2e": "node tests/e2e/fiveSchemesE2E.js",
    "test:analysis": "node tests/e2e/documentAnalysisFlowTest.js",
    "test": "npm run test:security && npm run test:digilocker && npm run test:wallet && npm run test:e2e && npm run test:analysis"
  },
  "keywords": [
    "scholarship",
    "fellowship",
    "tribal-affairs",
    "mota",
    "digilocker",
    "ai-verification"
  ],
  "author": "Ministry of Tribal Affairs",
  "license": "UNLICENSED"
}
