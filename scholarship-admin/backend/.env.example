# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tribexcel
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI verification engine (ai-engine service)
AI_ENGINE_URL=http://localhost:8000
# Schemes the AI engine has rules for; others use the built-in rule checks
AI_ENGINE_SCHEMES=NFST,NOS
