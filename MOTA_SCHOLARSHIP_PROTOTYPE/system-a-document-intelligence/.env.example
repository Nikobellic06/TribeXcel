# Ministry of Tribal Affairs (MoTA) Document Intelligence Engine
# System A - Document Intelligence Configuration

# Server Port
PORT=5001

# Node Environment
NODE_ENV=development

# Google Gemini API Key (Required for live AI document analysis)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Maximum file upload limit in MB (default: 10MB per document)
MAX_FILE_SIZE_MB=10

# Temporary upload directory
UPLOAD_DIR=./uploads
